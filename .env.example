# Optional credentials for future, read-only Kite market-data integration.
# Live order placement is not implemented and remains disabled by default.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Optional root override; paths are relative to this project by default.
NSE_RESEARCH_DATA_DIR=data

# OpenAlgo read-only one-minute history smoke test. Use the base URL of your
# running OpenAlgo instance, not https://openalgo.in/ (the public product site).
# Store the API key only in your local shell/secret manager; never commit it.
OPENALGO_API_BASE_URL=
OPENALGO_API_KEY=
OPENALGO_TIMEOUT_SECONDS=10
OPENALGO_REQUEST_INTERVAL_SECONDS=1

# Optional, read-only current-quote adapter. Disabled by default and separate
# from the historical OHLCV provider. Configure only an HTTPS API base URL.
REALTIME_PROVIDER=disabled
REALTIME_API_BASE_URL=
REALTIME_MAX_QUOTE_AGE_SECONDS=120
REALTIME_BATCH_SIZE=5
REALTIME_TIMEOUT_SECONDS=5
REALTIME_MAX_RETRIES=2
REALTIME_REQUEST_INTERVAL_SECONDS=1
REALTIME_CIRCUIT_FAILURE_THRESHOLD=3
REALTIME_CIRCUIT_COOLDOWN_SECONDS=60

# Upstox V3 market-data only. Never enable live trading for Phase 4A.8.
# Supply a valid token in the process environment or a secure secret manager;
# do not put a real token in this example file.
UPSTOX_ACCESS_TOKEN=
REALTIME_PROVIDER=upstox
REALTIME_ENABLED=false
REALTIME_UNIVERSE_SIZE=100
LIVE_TRADING=false
UPSTOX_MODE=ltpc
REALTIME_MAX_QUOTE_AGE_SECONDS=5
REALTIME_MAX_FUTURE_SKEW_SECONDS=1
UPSTOX_MAX_RECONNECT_ATTEMPTS=5
UPSTOX_MAPPING_REQUEST_DELAY_SECONDS=0.25
UPSTOX_MAPPING_MAX_RETRIES=3

# Forward paper trading is explicit and separate from historical backtests.
PAPER_TRADING_ENABLED=false
PAPER_STARTING_CAPITAL=
LIVE_TRADING_ENABLED=false

# Phase 4C paper execution. Defaults are fail-closed; the local synthetic
# validation script explicitly enables PAPER while still honoring LIVE and
# REALTIME safety flags above.
EXECUTION_MODE=PAPER
PAPER_INITIAL_CAPITAL=100000
RISK_PER_TRADE=0.01
MAX_POSITIONS=5
MAX_DAILY_LOSS=0.02
MAX_PORTFOLIO_DRAWDOWN=0.10
MAX_SYMBOL_EXPOSURE=0.25
MAX_SECTOR_EXPOSURE=0.25
MAX_GROSS_EXPOSURE=1.0
ALLOW_DUPLICATE_SYMBOL_POSITIONS=false
SIGNAL_MAX_AGE_SECONDS=60
PAPER_QUOTE_MAX_AGE_SECONDS=5
FORCE_INTRADAY_EXIT=true
PAPER_TRAILING_ATR_MULTIPLE=0
PAPER_SLIPPAGE_MODE=basis_points
